# OpenRouter API Key (required)
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Customize council models (comma-separated)
# Default: openai/gpt-4o,anthropic/claude-3.5-sonnet,google/gemini-2.0-flash-exp:free
# COUNCIL_MODELS=openai/gpt-4o,anthropic/claude-3.5-sonnet,google/gemini-2.0-flash-exp:free

# Optional: Customize chairman model
# Default: openai/gpt-4o
# CHAIRMAN_MODEL=openai/gpt-4o
